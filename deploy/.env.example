# 复制为 deploy/.env 后按需修改；不要提交真实密钥。
DB_PASSWORD=change-me
MYSQL_PORT=13306
REDIS_PORT=16379

# 四个宿主机端口
USER_API_PORT=18080
ADMIN_API_PORT=18081
USER_WEB_PORT=15173
ADMIN_WEB_PORT=15174
PROMETHEUS_PORT=9090

# 两个 JWT 密钥必须不同，至少 32 字节
USER_JWT_SECRET=change-me-user-secret-at-least-32-bytes
ADMIN_JWT_SECRET=change-me-admin-secret-at-least-32-bytes

# user-api 允许的前端来源（逗号分隔；插件使用 chrome-extension://*）
CORS_ALLOWED_ORIGINS=http://localhost:15173,http://127.0.0.1:15173,chrome-extension://*

# 登录/注册限流（次/分钟/IP）
AUTH_RATE_LIMIT_PER_MINUTE=10

# 问答限流（次/分钟/用户）
CHAT_RATE_LIMIT_PER_MINUTE=10

# 管理端操作限流（次/分钟/管理员）
ADMIN_RATE_LIMIT_PER_MINUTE=60

# 流式问答线程池：每个回答占用一个线程，并发高时调大
CHAT_EXECUTOR_CORE_SIZE=16
CHAT_EXECUTOR_MAX_SIZE=32
CHAT_EXECUTOR_QUEUE_CAPACITY=100
# 每次流式问答的个人配额预留（结束释放）
CHAT_RESERVE_TOKENS=8000
CHAT_RESERVE_COST=0.06

# 审计日志保留（默认 180 天，每日 03:30 UTC 清理）
AUDIT_RETENTION_ENABLED=true
AUDIT_RETENTION_DAYS=180

# Alertmanager 转发地址：生产替换为真实 Webhook/Slack/Feishu 接收器
ALERTMANAGER_PORT=9093
ALERTMANAGER_WEBHOOK_URL=http://host.docker.internal:19090/shiye-alerts
# 本地转发演练接收器（仅 monitoring-test profile）
WEBHOOK_SINK_PORT=19090

# SMTP（邮箱验证、找回密码、团队邀请邮件）
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@shiye.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
APP_PUBLIC_URL=http://localhost:15173

# HTTPS 入口（Caddy 自动申请 Let's Encrypt 证书）
# 本地可用 DOMAIN=localhost，Caddy 使用内部 CA；生产填写真实域名和邮箱
DOMAIN=localhost
ACME_EMAIL=

# 注册与预算默认值（管理端系统设置可在线覆盖）
REGISTRATION_ENABLED=true
REGISTRATION_INVITATION_REQUIRED=false
REGISTRATION_INVITATION_CODE=
REGISTRATION_DEFAULT_TOKEN_QUOTA=200000
REGISTRATION_DEFAULT_COST_QUOTA=5.000000
GLOBAL_MONTHLY_TOKENS=2000000
GLOBAL_MONTHLY_COST=20.00
USAGE_ALERT_THRESHOLD=0.8
USAGE_DAILY_TOKEN_LIMIT=0

# 日用量汇总（默认每天 00:15 UTC，回补最近 7 天）
USAGE_DAILY_AGGREGATION_ENABLED=true
USAGE_DAILY_CRON=0 15 0 * * *
USAGE_DAILY_BACKFILL_DAYS=7

# RAG 默认参数（管理端系统设置可在线覆盖）
RETRIEVAL_TOP_K=8
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_RERANK_ENABLED=true
AI_CITATION_REQUIRED=true
CHUNK_TARGET_SIZE=700
CHUNK_OVERLAP=100

# RAG 评测 worker
EVAL_WORKER_ENABLED=true
EVAL_WORKER_DELAY_MS=30000

# 扫描版 PDF OCR（需要服务器安装 tesseract 和 chi_sim/eng 语言包）
OCR_ENABLED=false
OCR_COMMAND=tesseract
OCR_LANG=chi_sim+eng
OCR_MIN_TEXT_CHARS=80
OCR_MAX_PAGES=20
OCR_DPI=200
OCR_TIMEOUT_MS=60000

# 预算告警 Webhook（管理端系统设置可在线覆盖；同一月同一级别只发送一次）
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
BUDGET_ALERT_SCHEDULER_ENABLED=true
BUDGET_ALERT_INITIAL_DELAY_MS=30000
BUDGET_ALERT_DELAY_MS=60000

# 上传文件保存目录（容器内默认 /app/data/uploads）
# FILE_UPLOAD_DIR=./data/uploads

# 数据清理任务（默认每天 03:30 UTC）
RETENTION_ENABLED=true
RETENTION_CRON=0 30 3 * * *
RETENTION_REFRESH_TOKEN_DAYS=30
RETENTION_EXTENSION_CODE_DAYS=7
RETENTION_IDEMPOTENCY_DAYS=1
RETENTION_INGEST_TASK_DAYS=30
RETENTION_BATCH_LIMIT=1000

# DeepSeek 聊天（留空则问答不可用）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 资料入库后自动生成摘要和标签（需要 DeepSeek Key；失败保留原摘要）
AI_ENRICHMENT_ENABLED=true
AI_ENRICHMENT_MAX_INPUT_CHARS=6000
AI_ENRICHMENT_MAX_TAGS=5

# Embedding：dev = 联调确定性向量；http = 真实 BGE-M3
EMBEDDING_PROVIDER=dev
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# Rerank：true 时对混合检索候选池做 BGE-reranker 二次排序；无 key 会自动回退 RRF
RERANK_ENABLED=false
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=20
RERANK_TIMEOUT_MS=20000
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_CANDIDATES=20

# CD 部署时使用 GHCR 镜像
# IMAGE_PREFIX=ghcr.io/your-org
# IMAGE_TAG=latest
