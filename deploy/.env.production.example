# 生产环境示例：复制为 deploy/.env.production 后修改；不要提交真实密钥。
# 端口统一绑定 127.0.0.1，由宝塔 Nginx 反代；避免与已有 offerdesk 项目冲突。

# 数据库/Redis 只开本机回环，不暴露公网
DB_PASSWORD=change-me-strong-password
MYSQL_PORT=127.0.0.1:23306
REDIS_PORT=127.0.0.1:26379

# API 只给同机 Nginx/调试使用；生产建议防火墙禁止公网访问
USER_API_PORT=127.0.0.1:28080
ADMIN_API_PORT=127.0.0.1:28081

# 宝塔 Nginx 反代目标
USER_WEB_PORT=127.0.0.1:25173
ADMIN_WEB_PORT=127.0.0.1:25174

# 监控默认不公开
PROMETHEUS_PORT=127.0.0.1:29090
ALERTMANAGER_PORT=127.0.0.1:29093

# 两个 JWT 密钥必须不同，至少 32 字节；用 `openssl rand -hex 32` 生成
USER_JWT_SECRET=change-me-user-secret-at-least-32-bytes
ADMIN_JWT_SECRET=change-me-admin-secret-at-least-32-bytes

# 直连 API 的 Docker 网段；宝塔在宿主机，web 容器 nginx 是 API 的直连对端
TRUSTED_PROXIES=172.16.0.0/12

# 生产域名：建议使用子域名，避免和已有项目抢根域名
DOMAIN=shiye.myhyw.asia
CORS_ALLOWED_ORIGINS=https://shiye.myhyw.asia,https://admin.shiye.myhyw.asia,chrome-extension://*
APP_PUBLIC_URL=https://shiye.myhyw.asia
ACME_EMAIL=ops@myhyw.asia

# 注册与预算
REGISTRATION_ENABLED=true
REGISTRATION_INVITATION_REQUIRED=false
REGISTRATION_DEFAULT_TOKEN_QUOTA=200000
REGISTRATION_DEFAULT_COST_QUOTA=5.000000
GLOBAL_MONTHLY_TOKENS=2000000
GLOBAL_MONTHLY_COST=20.00
USAGE_ALERT_THRESHOLD=0.8
USAGE_DAILY_TOKEN_LIMIT=0

# AI（生产必须替换为正式 key；不要提交）
AI_ENABLED=true
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_ENRICHMENT_ENABLED=true
EMBEDDING_PROVIDER=http
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANK_ENABLED=true
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 向量：4GB 服务器建议保持 hash；数据量小且内存足够再启用 redisearch
VECTOR_STORE=hash
VECTOR_BACKFILL=false

# SMTP
MAIL_ENABLED=false
MAIL_HOST=smtp.myhyw.asia
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@myhyw.asia
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# OCR：需要扫描版 PDF 时设 true 并重新构建镜像
INSTALL_OCR=false
OCR_ENABLED=false
OCR_LANG=chi_sim+eng

# 备份
BACKUP_BEFORE_DEPLOY=true
BACKUP_DIR=/opt/shiye/backups

# 如使用 CD 构建好的镜像，可设置以下变量并 BUILD_IMAGES=false
# IMAGE_PREFIX=ghcr.io/your-org
# IMAGE_TAG=latest
BUILD_IMAGES=true
