global:
  resolve_timeout: 5m

route:
  receiver: shiye-default
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: shiye-default
    webhook_configs:
      - url: "__WEBHOOK_URL__"
        send_resolved: true
        max_alerts: 20
